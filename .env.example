# RegionGuard Environment Configuration

# Server Port (default: 4000)
PORT=4000

# Node Environment
NODE_ENV=development

# Allowed CORS origins (comma-separated or single)
CORS_ORIGIN=http://localhost:5173

# Simulation tick rate in milliseconds (default: 1000)
SIMULATION_TICK_MS=1000

# Optional DNS Cloud Providers (default is simulated)
# Set to 'simulated', 'route53', or 'clouddns'
DNS_PROVIDER_TYPE=simulated

# AWS Route 53 Credentials (OPTIONAL - simulation runs fully offline without these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ROUTE53_HOSTED_ZONE_ID=

# Google Cloud DNS Credentials (OPTIONAL)
GCP_PROJECT_ID=
GCP_DNS_MANAGED_ZONE=
